# Copy to .claude/.env (gitignored) and fill from the two Replit deployments.
# The hook path (lib/server_sync.py) reads this file automatically via
# lib/config.py. For the in-session sdk-tools MCP server, these must ALSO be in
# the shell that launches `claude` (Claude Code expands ${VAR} in .mcp.json from
# the launch environment) — so after writing this file, relaunch with:
#   set -a; source .claude/.env; set +a; claude

# Repl A — mcp-assist-memory (bare origin, no trailing slash)
MEMORY_SERVER_URL=https://<repl-a>.replit.app
MCP_AUTH_TOKEN=<repl-a bearer token>

# Repl B — canvas-sdk-tools (bare origin, no trailing slash; token must differ from MCP_AUTH_TOKEN)
SDK_TOOLS_URL=https://<repl-b>.replit.app
SDK_TOOLS_TOKEN=<repl-b bearer token>

# Which surface this shell is — 'orchestrator' or one of the five subagent names
AGENT_ID=orchestrator
