{
  "$comment": "Local-first multi-agent wiring for the GLP-1 plugin. Hooks enforce the local-first/safety behavior deterministically (not by prompt). Set AGENT_ID, MEMORY_SERVER_URL, and MCP_AUTH_TOKEN per agent shell.",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(pytest:*)",
      "mcp__Memory_Assist__memory_save",
      "mcp__Memory_Assist__memory_get",
      "mcp__Memory_Assist__memory_list",
      "mcp__Memory_Assist__memory_search",
      "mcp__Memory_Assist__memory_history",
      "mcp__Memory_Assist__handoff_save",
      "mcp__Memory_Assist__handoff_load",
      "mcp__Memory_Assist__handoff_list",
      "mcp__Memory_Assist__session_append_event",
      "mcp__Memory_Assist__session_get",
      "mcp__Memory_Assist__session_events",
      "mcp__canvas-sdk-tools__capability",
      "mcp__canvas-sdk-tools__fhir_immutability",
      "mcp__canvas-sdk-tools__manifest",
      "mcp__canvas-sdk-tools__sandbox_imports",
      "mcp__canvas-sdk-tools__field_names",
      "mcp__canvas-sdk-tools__supported_versions"
    ],
    "deny": [
      "Bash(canvas install:*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_start_load.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse_guards.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post_tooluse_log.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_end_reconcile.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_end_reconcile.sh" }
        ]
      }
    ]
  }
}
