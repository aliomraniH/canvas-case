# Copy to .env (local) or set these in Replit Secrets. Read ONLY by config.py.

# --- required ---
# Neon POOLED endpoint (PgBouncer). Note the -pooler host and sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Bearer token clients must present on /mcp.
MCP_AUTH_TOKEN=change-me-long-random

# --- optional, used in Phase 3 (service boots without them) ---
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LANGSMITH_API_KEY=

# --- optional overrides (defaults shown) ---
# MAX_ARTIFACT_BYTES=52428800     # 50 MB
# PORT=8000

# NOTE: Canvas SDK credentials (~/.canvas/credentials.ini) NEVER go here.
